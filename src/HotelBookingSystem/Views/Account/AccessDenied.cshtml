@{
    ViewData["Title"] = "Access Denied - GrandVista";
}

<div class="container py-5 text-center">
    <div class="py-5">
        <div class="display-1 text-danger mb-3">
            <i class="bi bi-shield-x"></i>
        </div>
        <h1 class="display-5 font-heading text-primary mb-2">Access Denied</h1>
        <p class="lead text-muted mx-auto mb-4" style="max-width: 500px;">
            You do not possess the required administrator privileges to view this management console.
        </p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-forest">
                <i class="bi bi-house-door me-1"></i> Return to Guest Website
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-gold">
                <i class="bi bi-person-badge me-1"></i> Admin Login
            </a>
        </div>
    </div>
</div>
