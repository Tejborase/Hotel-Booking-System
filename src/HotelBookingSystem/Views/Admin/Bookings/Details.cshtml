@model HotelBookingSystem.Models.Booking
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Reservation #{Model.BookingReference}";
    var nights = (Model.CheckOutDate.Date - Model.CheckInDate.Date).Days;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="font-heading text-primary mb-1">Reservation Details & Audit</h4>
        <p class="text-muted small mb-0">Reference code: <span class="font-monospace fw-bold text-dark">@Model.BookingReference</span></p>
    </div>
    <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Reservations
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm mb-4">
            <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
                <h5 class="font-heading fw-bold mb-0">Guest Profile</h5>
                <div>
                    @if (Model.BookingStatus == "Confirmed")
                    {
                        <span class="badge-status-confirmed fs-6"><i class="bi bi-check-circle-fill"></i> Confirmed</span>
                    }
                    else if (Model.BookingStatus == "Pending")
                    {
                        <span class="badge-status-pending fs-6"><i class="bi bi-clock-fill"></i> Pending</span>
                    }
                    else
                    {
                        <span class="badge-status-cancelled fs-6"><i class="bi bi-x-circle-fill"></i> Cancelled</span>
                    }
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-sm-6">
                    <label class="text-muted small text-uppercase fw-bold">Full Name</label>
                    <div class="fs-5 fw-semibold text-dark">@Model.GuestName</div>
                </div>
                <div class="col-sm-6">
                    <label class="text-muted small text-uppercase fw-bold">Guest Count</label>
                    <div class="fs-5 fw-semibold text-dark">@Model.GuestsCount @(Model.GuestsCount == 1 ? "Guest" : "Guests")</div>
                </div>
                <div class="col-sm-6">
                    <label class="text-muted small text-uppercase fw-bold">Email Address</label>
                    <div class="fw-semibold text-dark">
                        <a href="mailto:@Model.Email" class="text-primary text-decoration-none"><i class="bi bi-envelope me-1"></i>@Model.Email</a>
                    </div>
                </div>
                <div class="col-sm-6">
                    <label class="text-muted small text-uppercase fw-bold">Phone Number</label>
                    <div class="fw-semibold text-dark">
                        <a href="tel:@Model.Phone" class="text-primary text-decoration-none"><i class="bi bi-telephone me-1"></i>@Model.Phone</a>
                    </div>
                </div>
            </div>

            <h5 class="font-heading fw-bold border-bottom pb-2 mb-3">Reservation Schedule</h5>
            <div class="row g-3 mb-4">
                <div class="col-sm-4">
                    <label class="text-muted small text-uppercase fw-bold">Check-in Date</label>
                    <div class="fw-bold text-dark fs-6">@Model.CheckInDate.ToString("ddd, MMM dd, yyyy")</div>
                    <small class="text-muted">Standard 3:00 PM</small>
                </div>
                <div class="col-sm-4">
                    <label class="text-muted small text-uppercase fw-bold">Check-out Date</label>
                    <div class="fw-bold text-dark fs-6">@Model.CheckOutDate.ToString("ddd, MMM dd, yyyy")</div>
                    <small class="text-muted">Standard 11:00 AM</small>
                </div>
                <div class="col-sm-4">
                    <label class="text-muted small text-uppercase fw-bold">Length of Stay</label>
                    <div class="fw-bold text-primary fs-6">@nights Night@(nights > 1 ? "s" : "")</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.SpecialRequests))
            {
                <h5 class="font-heading fw-bold border-bottom pb-2 mb-3">Guest Special Requests</h5>
                <div class="p-3 bg-light rounded-3 border mb-4">
                    <i class="bi bi-chat-quote text-warning me-2 fs-5"></i>
                    <span>@Model.SpecialRequests</span>
                </div>
            }

            <h5 class="font-heading fw-bold border-bottom pb-2 mb-3">Audit Information</h5>
            <div class="row g-3 small text-muted">
                <div class="col-sm-6">
                    <strong>Reservation Created:</strong> @Model.CreatedAt.ToString("g") UTC
                </div>
                <div class="col-sm-6">
                    <strong>Internal Booking ID:</strong> #@Model.BookingId
                </div>
            </div>
        </div>
    </div>

    <!-- Financial & Suite Information -->
    <div class="col-lg-4">
        <!-- Suite Information -->
        @if (Model.Room != null)
        {
            <div class="card border rounded-4 p-4 bg-white shadow-sm mb-4">
                <h5 class="font-heading fw-bold mb-3">Reserved Suite</h5>
                <img src="@Model.Room.ImageUrl" alt="@Model.Room.RoomType" class="img-fluid rounded-3 object-fit-cover mb-3" style="height: 150px; width: 100%;" />
                <h6 class="fw-bold text-dark mb-1">@Model.Room.RoomType</h6>
                <div class="text-muted small mb-2">Room #@Model.Room.RoomNumber &bull; Max @Model.Room.Capacity Guests</div>
                <div class="small text-secondary mb-3">@Model.Room.Amenities</div>
                <a asp-area="Admin" asp-controller="Rooms" asp-action="Edit" asp-route-id="@Model.Room.RoomId" class="btn btn-outline-forest btn-sm w-100">
                    <i class="bi bi-gear me-1"></i> View Suite Record
                </a>
            </div>
        }

        <!-- Financial Summary -->
        <div class="card border rounded-4 p-4 bg-white shadow-sm mb-4">
            <h5 class="font-heading fw-bold mb-3">Billing & Payment</h5>
            
            <div class="price-breakdown-row">
                <span>Agreed Nightly Rate</span>
                <span class="fw-semibold">$@Model.PricePerNight.ToString("N2")</span>
            </div>
            <div class="price-breakdown-row">
                <span>Nights Billed</span>
                <span>@nights night@(nights > 1 ? "s" : "")</span>
            </div>
            <div class="price-breakdown-row">
                <span>Payment Terms</span>
                <span class="text-success fw-semibold">Pay at Hotel</span>
            </div>
            <div class="price-breakdown-row total">
                <span>Total Amount</span>
                <span>$@Model.TotalAmount.ToString("N2")</span>
            </div>
        </div>

        <!-- Management Actions -->
        <div class="card border rounded-4 p-4 bg-white shadow-sm">
            <h5 class="font-heading fw-bold mb-3">Status Management</h5>

            <div class="d-grid gap-2">
                @if (Model.BookingStatus != "Confirmed")
                {
                    <form asp-area="Admin" asp-controller="Bookings" asp-action="Confirm" asp-route-id="@Model.BookingId" method="post"
                          onsubmit="return confirm('Confirm this reservation?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100 py-2">
                            <i class="bi bi-check-circle me-1"></i> Mark as Confirmed
                        </button>
                    </form>
                }

                @if (Model.BookingStatus != "Cancelled")
                {
                    <form asp-area="Admin" asp-controller="Bookings" asp-action="Cancel" asp-route-id="@Model.BookingId" method="post"
                          onsubmit="return confirm('Cancel this reservation? Availability will be restored.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100 py-2">
                            <i class="bi bi-x-circle me-1"></i> Cancel Reservation
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>
