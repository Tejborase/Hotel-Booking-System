@model HotelBookingSystem.ViewModels.BookingAdminFilterViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Manage Guest Reservations";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
    <div>
        <h4 class="font-heading text-primary mb-1">Guest Reservations</h4>
        <p class="text-muted small mb-0">Search, review, confirm, or cancel bookings across all hotel rooms.</p>
    </div>
</div>

<!-- Filters & Search Toolbar -->
<div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
    <form asp-area="Admin" asp-controller="Bookings" asp-action="Index" method="get">
        <div class="row g-2 align-items-center">
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" class="form-control" 
                           placeholder="Search by reference, guest name, email, phone, or room #" 
                           value="@Model.SearchTerm" />
                </div>
            </div>

            <div class="col-md-3">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="All" selected="@(Model.Status == "All")">All Statuses</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending Only</option>
                    <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Confirmed Only</option>
                    <option value="Cancelled" selected="@(Model.Status == "Cancelled")">Cancelled Only</option>
                </select>
            </div>

            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-forest flex-grow-1">
                    <i class="bi bi-funnel me-1"></i> Filter
                </button>
                <a asp-area="Admin" asp-controller="Bookings" asp-action="Index" class="btn btn-outline-secondary">
                    Reset
                </a>
            </div>
        </div>
    </form>
</div>

<!-- Bookings Table -->
<div class="gv-table-card">
    <div class="table-responsive">
        <table class="table gv-table align-middle">
            <thead>
                <tr>
                    <th>Reference</th>
                    <th>Guest Details</th>
                    <th>Suite</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Guests</th>
                    <th>Total ($)</th>
                    <th>Status</th>
                    <th class="text-end" style="min-width: 200px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Bookings.Any())
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            No reservations found matching the specified criteria.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var b in Model.Bookings)
                    {
                        <tr>
                            <td class="font-monospace fw-bold text-dark">
                                <a asp-area="Admin" asp-controller="Bookings" asp-action="Details" asp-route-id="@b.BookingId" class="text-decoration-none text-primary">
                                    @b.BookingReference
                                </a>
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">@b.GuestName</div>
                                <div class="text-muted small"><i class="bi bi-envelope me-1"></i>@b.Email</div>
                                <div class="text-muted small"><i class="bi bi-telephone me-1"></i>@b.Phone</div>
                            </td>
                            <td>
                                <div class="fw-semibold">Suite #@(b.Room?.RoomNumber ?? b.RoomId.ToString())</div>
                                <div class="text-muted small">@(b.Room?.RoomType ?? "Standard")</div>
                            </td>
                            <td class="small fw-semibold text-dark">
                                @b.CheckInDate.ToString("MMM dd, yyyy")
                            </td>
                            <td class="small fw-semibold text-dark">
                                @b.CheckOutDate.ToString("MMM dd, yyyy")
                                <div class="text-muted fw-normal">@((b.CheckOutDate.Date - b.CheckInDate.Date).Days) nights</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    <i class="bi bi-person me-1"></i>@b.GuestsCount
                                </span>
                            </td>
                            <td class="fw-bold text-primary fs-6">
                                $@b.TotalAmount.ToString("N2")
                            </td>
                            <td>
                                @if (b.BookingStatus == "Confirmed")
                                {
                                    <span class="badge-status-confirmed"><i class="bi bi-check-circle-fill"></i> Confirmed</span>
                                }
                                else if (b.BookingStatus == "Pending")
                                {
                                    <span class="badge-status-pending"><i class="bi bi-clock-fill"></i> Pending</span>
                                }
                                else
                                {
                                    <span class="badge-status-cancelled"><i class="bi bi-x-circle-fill"></i> Cancelled</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-1">
                                    <a asp-area="Admin" asp-controller="Bookings" asp-action="Details" asp-route-id="@b.BookingId" 
                                       class="btn btn-sm btn-outline-primary" title="View Reservation Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (b.BookingStatus != "Confirmed")
                                    {
                                        <form asp-area="Admin" asp-controller="Bookings" asp-action="Confirm" asp-route-id="@b.BookingId" method="post" class="d-inline"
                                              onsubmit="return confirm('Confirm this reservation?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Confirm Booking">
                                                <i class="bi bi-check-lg"></i> Confirm
                                            </button>
                                        </form>
                                    }

                                    @if (b.BookingStatus != "Cancelled")
                                    {
                                        <form asp-area="Admin" asp-controller="Bookings" asp-action="Cancel" asp-route-id="@b.BookingId" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to cancel booking @b.BookingReference? This will release the room availability for those dates.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Cancel Booking">
                                                <i class="bi bi-x-lg"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
