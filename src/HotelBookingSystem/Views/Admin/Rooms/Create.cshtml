@model HotelBookingSystem.ViewModels.RoomAdminViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Add New Hotel Suite";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="font-heading text-primary mb-1">Create New Suite</h4>
                <p class="text-muted small mb-0">Define room specifications and imagery to make available for guest booking.</p>
            </div>
            <a asp-area="Admin" asp-controller="Rooms" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Rooms List
            </a>
        </div>

        <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm">
            <form asp-area="Admin" asp-controller="Rooms" asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3 mb-4"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="RoomNumber" class="form-label small fw-bold text-uppercase text-muted"></label>
                        <input asp-for="RoomNumber" class="form-control font-monospace" placeholder="e.g. 105" required />
                        <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                        <div class="form-text small">Must be unique across all rooms.</div>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="RoomType" class="form-label small fw-bold text-uppercase text-muted"></label>
                        <input asp-for="RoomType" class="form-control" placeholder="e.g. Executive Panoramic Suite" required />
                        <span asp-validation-for="RoomType" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PricePerNight" class="form-label small fw-bold text-uppercase text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input asp-for="PricePerNight" type="number" step="0.01" min="1" class="form-control" required />
                        </div>
                        <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label small fw-bold text-uppercase text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-people"></i></span>
                            <input asp-for="Capacity" type="number" min="1" max="20" class="form-control" required />
                        </div>
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label small fw-bold text-uppercase text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-image"></i></span>
                        <input asp-for="ImageUrl" class="form-control" placeholder="https://images.unsplash.com/..." required />
                    </div>
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    <div class="form-text small">Provide a direct high-resolution image URL.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-bold text-uppercase text-muted"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed luxury description of suite, bedding, views, and atmosphere..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Amenities" class="form-label small fw-bold text-uppercase text-muted"></label>
                    <input asp-for="Amenities" class="form-control" placeholder="King Bed, Ocean View, High-Speed Wi-Fi, Marble Tub, Espresso Machine" />
                    <span asp-validation-for="Amenities" class="text-danger small"></span>
                    <div class="form-text small">Enter comma-separated amenity names.</div>
                </div>

                <div class="mb-4 form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="activeSwitch" checked />
                    <label class="form-check-label fw-semibold text-dark" for="activeSwitch">Active Suite (Immediately bookable by guests)</label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-area="Admin" asp-controller="Rooms" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-gold px-4">
                        <i class="bi bi-check-circle me-1"></i> Save Room
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
