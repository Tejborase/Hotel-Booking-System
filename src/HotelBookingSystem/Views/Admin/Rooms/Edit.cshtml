@model HotelBookingSystem.ViewModels.RoomAdminViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = $"Edit Suite #{Model.RoomNumber}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="font-heading text-primary mb-1">Edit Suite #@Model.RoomNumber</h4>
                <p class="text-muted small mb-0">Update pricing, description, capacity, or status for this accommodation.</p>
            </div>
            <a asp-area="Admin" asp-controller="Rooms" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Rooms List
            </a>
        </div>

        <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm">
            <form asp-area="Admin" asp-controller="Rooms" asp-action="Edit" asp-route-id="@Model.RoomId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="RoomId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger shadow-sm rounded-3 mb-4"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label asp-for="RoomNumber" class="form-label small fw-bold text-uppercase text-muted"></label>
                        <input asp-for="RoomNumber" class="form-control font-monospace" required />
                        <span asp-validation-for="RoomNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-8">
                        <label asp-for="RoomType" class="form-label small fw-bold text-uppercase text-muted"></label>
                        <input asp-for="RoomType" class="form-control" required />
                        <span asp-validation-for="RoomType" class="text-danger small"></span>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="PricePerNight" class="form-label small fw-bold text-uppercase text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light">$</span>
                            <input asp-for="PricePerNight" type="number" step="0.01" min="1" class="form-control" required />
                        </div>
                        <span asp-validation-for="PricePerNight" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Capacity" class="form-label small fw-bold text-uppercase text-muted"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-people"></i></span>
                            <input asp-for="Capacity" type="number" min="1" max="20" class="form-control" required />
                        </div>
                        <span asp-validation-for="Capacity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label small fw-bold text-uppercase text-muted"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light"><i class="bi bi-image"></i></span>
                        <input asp-for="ImageUrl" class="form-control" id="roomImgInput" required />
                    </div>
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <!-- Preview Image -->
                <div class="mb-3">
                    <label class="form-label small text-muted text-uppercase fw-bold">Current Imagery Preview</label>
                    <div class="rounded-3 overflow-hidden border shadow-sm" style="max-height: 220px; max-width: 400px;">
                        <img src="@Model.ImageUrl" alt="@Model.RoomType" id="roomImgPreview" class="img-fluid w-100 object-fit-cover" style="height: 200px;" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label small fw-bold text-uppercase text-muted"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Amenities" class="form-label small fw-bold text-uppercase text-muted"></label>
                    <input asp-for="Amenities" class="form-control" />
                    <span asp-validation-for="Amenities" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="activeSwitch" />
                    <label class="form-check-label fw-semibold text-dark" for="activeSwitch">Active Suite (Guests can reserve)</label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-area="Admin" asp-controller="Rooms" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-gold px-4">
                        <i class="bi bi-check-circle me-1"></i> Update Suite Details
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const input = document.getElementById('roomImgInput');
        const preview = document.getElementById('roomImgPreview');
        input?.addEventListener('change', function() {
            if (input.value) {
                preview.src = input.value;
            }
        });
    </script>
}
