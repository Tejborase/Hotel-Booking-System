@{
    ViewData["Title"] = "Our Heritage & Story - GrandVista Hotel";
}

<div class="bg-dark text-white py-5" style="background: linear-gradient(rgba(15, 39, 32, 0.85), rgba(15, 39, 32, 0.85)), url('https://images.unsplash.com/photo-1542314831-068cd1dbfeeb?auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;">
    <div class="container text-center py-4">
        <span class="text-uppercase text-gold fw-bold letter-spacing-2 small">Timeless Elegance</span>
        <h1 class="display-5 font-heading text-white mt-2 mb-2">The GrandVista Story</h1>
        <p class="lead text-white-50 mx-auto" style="max-width: 650px;">
            Founded on the principle that true luxury is deeply personal, tranquil, and rooted in effortless grace.
        </p>
    </div>
</div>

<div class="container py-5">
    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="text-uppercase text-gold fw-bold letter-spacing-2 small">Our Philosophy</span>
            <h2 class="display-6 font-heading mt-2 mb-4">A Haven of Quiet Grandeur</h2>
            <p class="lead text-secondary">
                At GrandVista, we believe an exceptional stay is defined by quiet moments: the morning breeze across your private balcony, the soothing warmth of hand-poured tea, and the unspoken attention of staff who remember your preferences.
            </p>
            <p class="text-muted">
                Constructed with sustainable local stone and timber, GrandVista features 8 bespoke luxury suites ranging from panoramic oceanfront residences to the top-floor Presidential Penthouse. Every fixture has been curated by award-winning interior designers to harmonize modern elegance with coastal calm.
            </p>
        </div>
        <div class="col-lg-6">
            <img src="https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1000&q=80" alt="GrandVista Lobby" class="img-fluid rounded-4 shadow-lg" />
        </div>
    </div>

    <!-- Core Pillars -->
    <div class="row g-4 mt-4">
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <i class="bi bi-shield-check text-warning fs-1 mb-3"></i>
                <h4 class="h5 font-heading">Bespoke Hospitality</h4>
                <p class="text-muted small">Every stay is customized from pre-arrival pillow selections to private chauffeur itineraries.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <i class="bi bi-tree text-warning fs-1 mb-3"></i>
                <h4 class="h5 font-heading">Eco-Conscious Luxury</h4>
                <p class="text-muted small">100% renewable power, zero single-use plastics, and organic culinary sourcing from regional farms.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 bg-white rounded-4 border shadow-sm text-center h-100">
                <i class="bi bi-award text-warning fs-1 mb-3"></i>
                <h4 class="h5 font-heading">Michelin Culinary Art</h4>
                <p class="text-muted small">Gastronomic excellence overseen by celebrated European masters in an intimate coastal dining salon.</p>
            </div>
        </div>
    </div>
</div>
