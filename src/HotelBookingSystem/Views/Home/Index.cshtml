@model HotelBookingSystem.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "Luxury Stays & Bespoke Hospitality";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container position-relative z-2">
        <div class="hero-subtitle-badge">
            <i class="bi bi-star-fill text-warning"></i>
            <span>Award-Winning 5-Star Boutique Experience</span>
        </div>
        <h1 class="hero-title">Experience Comfort.<br>Discover Luxury.</h1>
        <p class="hero-desc">
            Nestled along the pristine coastal bay, GrandVista redefines hospitality with timeless architecture, tranquil ocean suites, and intuitive personal service tailored to your every rhythm.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-3">
            <a href="#booking-search" class="btn btn-gold btn-lg">
                <i class="bi bi-calendar-check me-1"></i> Book Your Stay
            </a>
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-light btn-lg">
                <i class="bi bi-compass me-1"></i> Explore All Suites
            </a>
        </div>
    </div>
</section>

<!-- Floating Booking Search Form -->
<div class="container search-widget-container" id="booking-search">
    <div class="search-widget-card">
        <form asp-controller="Rooms" asp-action="Index" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label" for="homeCheckIn">
                        <i class="bi bi-calendar-event text-warning"></i> Check-in Date
                    </label>
                    <input type="date" class="form-control" id="homeCheckIn" name="checkInDate" 
                           value="@Model.CheckInDate.ToString("yyyy-MM-dd")" 
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label" for="homeCheckOut">
                        <i class="bi bi-calendar-check text-warning"></i> Check-out Date
                    </label>
                    <input type="date" class="form-control" id="homeCheckOut" name="checkOutDate" 
                           value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" 
                           min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                </div>

                <div class="col-lg-3 col-md-6">
                    <label class="form-label" for="homeGuests">
                        <i class="bi bi-people text-warning"></i> Guests Count
                    </label>
                    <select class="form-select" id="homeGuests" name="guests">
                        <option value="1">1 Guest</option>
                        <option value="2" selected>2 Guests</option>
                        <option value="3">3 Guests</option>
                        <option value="4">4 Guests</option>
                        <option value="5">5+ Guests (Family)</option>
                    </select>
                </div>

                <div class="col-lg-3 col-md-6">
                    <button type="submit" class="btn btn-gold w-100 py-3">
                        <i class="bi bi-search me-1"></i> Search Available Rooms
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Featured Rooms Section -->
<section class="py-5 mt-4">
    <div class="container py-4">
        <div class="text-center mb-5">
            <span class="text-uppercase text-gold fw-bold letter-spacing-2 small">Accommodations</span>
            <h2 class="display-6 fw-bold mt-2">Featured Luxury Suites</h2>
            <p class="text-muted mx-auto" style="max-width: 600px;">
                Each room is an oasis of calm, curated with handcrafted furnishings, marble baths, and floor-to-ceiling windows overlooking breathtaking vistas.
            </p>
        </div>

        <div class="row g-4">
            @foreach (var room in Model.FeaturedRooms)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="room-card">
                        <div class="room-card-image-wrap">
                            <img src="@room.ImageUrl" alt="@room.RoomType" class="room-card-image" loading="lazy" />
                            <span class="room-badge-type">@room.RoomType</span>
                            <div class="room-badge-price">
                                $@room.PricePerNight.ToString("N0") <span>/ night</span>
                            </div>
                        </div>

                        <div class="room-card-body">
                            <h3 class="room-card-title">@room.RoomType</h3>
                            
                            <div class="room-meta-tags">
                                <span class="room-meta-tag"><i class="bi bi-people text-warning"></i> Up to @room.Capacity guests</span>
                                <span class="room-meta-tag"><i class="bi bi-door-closed text-warning"></i> Room #@room.RoomNumber</span>
                            </div>

                            <p class="room-description">@room.Description</p>

                            <div class="room-amenity-pills">
                                @if (!string.IsNullOrEmpty(room.Amenities))
                                {
                                    @foreach (var amenity in room.Amenities.Split(',', StringSplitOptions.TrimEntries).Take(4))
                                    {
                                        <span class="amenity-pill"><i class="bi bi-check2 text-success me-1"></i>@amenity</span>
                                    }
                                }
                            </div>

                            <div class="room-card-actions">
                                <a asp-controller="Rooms" asp-action="Details" asp-route-id="@room.RoomId" class="btn btn-outline-forest flex-grow-1">
                                    View Details
                                </a>
                                <a asp-controller="Bookings" asp-action="Create" asp-route-roomId="@room.RoomId" class="btn btn-gold flex-grow-1">
                                    Book Now
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <a asp-controller="Rooms" asp-action="Index" class="btn btn-outline-forest btn-lg">
                View All Rooms & Suites (@Model.TotalRoomsAvailable Available) <i class="bi bi-arrow-right ms-2"></i>
            </a>
        </div>
    </div>
</section>

<!-- Hotel Facilities Section -->
