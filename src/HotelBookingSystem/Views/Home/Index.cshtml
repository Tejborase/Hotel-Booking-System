<!-- Call to Action Banner -->
<section class="py-5" style="background: var(--gv-primary); color: #FFFFFF;">
    <div class="container py-4 text-center">
        <h2 class="display-6 font-heading text-white mb-3">Your Unforgettable Escape Awaits</h2>
        <p class="lead text-white-50 mx-auto mb-4" style="max-width: 650px;">
            Reserve your suite directly with GrandVista for complimentary welcome champagne, high-floor privileges, and flexible check-out.
        </p>
        <a asp-controller="Rooms" asp-action="Index" class="btn btn-gold btn-lg px-5">
            Browse All Suites & Rates
        </a>
    </div>
</section>

@section Scripts {
    <script>
        // Synchronize date constraints
        const checkIn = document.getElementById('homeCheckIn');
        const checkOut = document.getElementById('homeCheckOut');

        checkIn.addEventListener('change', function () {
            if (checkIn.value) {
                const nextDay = new Date(checkIn.value);
                nextDay.setDate(nextDay.getDate() + 1);
                const nextDayStr = nextDay.toISOString().split('T')[0];
                checkOut.min = nextDayStr;
                if (checkOut.value <= checkIn.value) {
                    checkOut.value = nextDayStr;
                }
            }
        });
    </script>
}
