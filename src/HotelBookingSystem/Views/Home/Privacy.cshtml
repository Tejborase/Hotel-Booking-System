@{
    ViewData["Title"] = "Privacy Policy - GrandVista Hotel";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <h1 class="display-6 font-heading mb-4 text-primary">Privacy Policy</h1>
            <p class="text-muted">Last updated: October 2026</p>

            <div class="card border rounded-4 p-4 p-md-5 bg-white shadow-sm mb-4">
                <h4 class="h5 font-heading text-primary mb-3">1. Information We Collect</h4>
                <p class="text-muted small">
                    When you make a reservation at GrandVista Hotel, we collect necessary guest information including your full name, email address, phone number, stay dates, and any special accommodation requests.
                </p>

                <h4 class="h5 font-heading text-primary mb-3 mt-4">2. Use of Your Information</h4>
                <p class="text-muted small">
                    Your details are utilized strictly to secure your suite reservation, communicate arrival instructions, provide customer support, and comply with hospitality regulations. We never sell or rent guest data to third-party advertisers.
                </p>

                <h4 class="h5 font-heading text-primary mb-3 mt-4">3. Data Security & Storage</h4>
                <p class="text-muted small">
                    All reservation details are persisted securely in encrypted SQL Server databases utilizing ASP.NET Core Identity standards, parameterized queries, and strict access controls.
                </p>

                <h4 class="h5 font-heading text-primary mb-3 mt-4">4. Reservation Lookup Privacy</h4>
                <p class="text-muted small">
                    Our My Booking service requires matching both your exact booking reference code and registered email address to prevent unauthorized retrieval of personal stay details.
                </p>
            </div>
        </div>
    </div>
</div>
