@model HotelBookingSystem.ViewModels.RoomDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Room.RoomType} - GrandVista Suites";
}

<!-- Breadcrumbs -->
<div class="bg-light py-3 border-bottom">
    <div class="container">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-controller="Rooms" asp-action="Index">Rooms & Suites</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Room.RoomType (Room @Model.Room.RoomNumber)</li>
            </ol>
        </nav>
    </div>
</div>

<div class="container py-5">
    <div class="row g-5">
        <!-- Main Content (Gallery, Description, Amenities) -->
        <div class="col-lg-8">
            <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
                <div>
                    <span class="badge bg-secondary text-primary px-3 py-2 rounded-pill fw-semibold mb-2">
                        Room #@Model.Room.RoomNumber
                    </span>
                    <h1 class="display-6 font-heading mb-1">@Model.Room.RoomType</h1>
                </div>
                <div class="text-end mt-2 mt-sm-0">
                    <span class="fs-2 fw-bold text-primary font-heading">$@Model.Room.PricePerNight.ToString("N0")</span>
                    <span class="text-muted small">/ night</span>
                </div>
            </div>

            <!-- Large Photography Gallery -->
            <div class="room-gallery-main">
                <img src="@Model.Room.ImageUrl" alt="@Model.Room.RoomType" class="img-fluid w-100 h-100 object-fit-cover rounded-4 shadow-sm" />
            </div>

            <!-- Key Highlights Quick Bar -->
            <div class="card border rounded-4 p-4 mb-5 bg-white shadow-sm">
                <div class="row text-center g-3">
                    <div class="col-sm-4 border-end">
                        <div class="text-muted small text-uppercase">Capacity</div>
                        <div class="fs-5 fw-bold text-dark mt-1">
                            <i class="bi bi-people text-warning me-1"></i> Up to @Model.Room.Capacity Guests
                        </div>
                    </div>
                    <div class="col-sm-4 border-end">
                        <div class="text-muted small text-uppercase">Room Number</div>
                        <div class="fs-5 fw-bold text-dark mt-1">
                            <i class="bi bi-door-closed text-warning me-1"></i> Suite @Model.Room.RoomNumber
                        </div>
                    </div>
                    <div class="col-sm-4">
                        <div class="text-muted small text-uppercase">Status</div>
                        <div class="fs-5 fw-bold text-success mt-1">
                            <i class="bi bi-shield-check me-1"></i> Active & Sanitized
                        </div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div class="mb-5">
                <h3 class="h4 font-heading mb-3">Suite Overview</h3>
                <p class="lead text-secondary" style="font-size: 1.05rem; line-height: 1.8;">
                    @Model.Room.Description
                </p>
                <p class="text-muted">
                    Designed with high ceilings, acoustic soundproofing, and organic linens, this suite provides an unmatched sanctuary whether unwinding after coastal explorations or preparing for executive meetings.
                </p>
            </div>

            <!-- Amenities -->
            <div class="mb-5">
                <h3 class="h4 font-heading mb-3">Suite Amenities & Conveniences</h3>
                <div class="row g-3">
                    @if (!string.IsNullOrEmpty(Model.Room.Amenities))
                    {
                        @foreach (var amenity in Model.Room.Amenities.Split(',', StringSplitOptions.TrimEntries))
                        {
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 p-2 rounded bg-light border">
                                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                    <span class="fw-medium text-dark">@amenity</span>
                                </div>
                            </div>
                        }
                    }
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2 p-2 rounded bg-light border">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span class="fw-medium text-dark">Evening Turndown & Pillow Menu</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="d-flex align-items-center gap-2 p-2 rounded bg-light border">
                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                            <span class="fw-medium text-dark">Climate Controlled Air Purification</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Hotel Policies -->
            <div class="card border rounded-4 p-4 bg-white mb-5">
                <h4 class="h5 font-heading mb-3">House & Reservation Policies</h4>
                <ul class="list-unstyled mb-0 small text-secondary">
                    <li class="mb-2"><i class="bi bi-clock me-2 text-warning"></i><strong>Check-in:</strong> 3:00 PM | <strong>Check-out:</strong> 11:00 AM</li>
                    <li class="mb-2"><i class="bi bi-credit-card me-2 text-warning"></i><strong>Payment:</strong> Payment is collected directly at hotel check-in. Credit card guarantees reservation.</li>
                    <li class="mb-2"><i class="bi bi-arrow-repeat me-2 text-warning"></i><strong>Cancellation:</strong> Complimentary cancellation up to 48 hours prior to arrival.</li>
                    <li class="mb-0"><i class="bi bi-slash-circle me-2 text-warning"></i><strong>Non-Smoking:</strong> All indoor suites and public spaces are 100% smoke-free.</li>
                </ul>
            </div>
        </div>

        <!-- Sticky Booking Panel -->
        <div class="col-lg-4">
            <div class="sticky-booking-card">
                <div class="d-flex justify-content-between align-items-center pb-3 mb-3 border-bottom">
                    <div>
                        <span class="fs-3 fw-bold text-primary font-heading">$@Model.Room.PricePerNight.ToString("N0")</span>
                        <span class="text-muted small">/ night</span>
                    </div>
                    @if (Model.IsAvailableForSelectedDates)
                    {
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                            <i class="bi bi-check-circle me-1"></i> Available
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-3 py-2 rounded-pill">
                            <i class="bi bi-x-circle me-1"></i> Unavailable
                        </span>
                    }
                </div>

                <!-- Live Dates Selector -->
                <form asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.Room.RoomId" method="get" id="detailsDateForm">
                    <input type="hidden" name="id" value="@Model.Room.RoomId" />
                    
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted" for="detailsCheckIn">Check-in Date</label>
                        <input type="date" class="form-control" id="detailsCheckIn" name="checkIn" 
                               value="@Model.CheckInDate.ToString("yyyy-MM-dd")" 
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted" for="detailsCheckOut">Check-out Date</label>
                        <input type="date" class="form-control" id="detailsCheckOut" name="checkOut" 
                               value="@Model.CheckOutDate.ToString("yyyy-MM-dd")" 
                               min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-uppercase text-muted" for="detailsGuests">Number of Guests</label>
                        <select class="form-select" id="detailsGuests" name="guests">
                            @for (int i = 1; i <= Model.Room.Capacity; i++)
                            {
                                <option value="@i" selected="@(Model.Guests == i)">@i @(i == 1 ? "Guest" : "Guests")</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="btn btn-outline-forest w-100 btn-sm mb-4">
                        <i class="bi bi-arrow-repeat me-1"></i> Update Pricing & Dates
                    </button>
                </form>

                <!-- Pricing Summary Table -->
                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="price-breakdown-row">
                        <span>$@Model.Room.PricePerNight.ToString("N0") &times; @Model.NumberOfNights night@(Model.NumberOfNights > 1 ? "s" : "")</span>
                        <span>$@Model.EstimatedTotal.ToString("N2")</span>
                    </div>
                    <div class="price-breakdown-row">
                        <span>Complimentary High-Speed Wi-Fi</span>
                        <span class="text-success fw-semibold">FREE</span>
                    </div>
                    <div class="price-breakdown-row">
                        <span>Concierge & Turndown Service</span>
                        <span class="text-success fw-semibold">INCLUDED</span>
                    </div>
                    <div class="price-breakdown-row total">
                        <span>Estimated Total</span>
                        <span>$@Model.EstimatedTotal.ToString("N2")</span>
                    </div>
                    <div class="text-muted small mt-2">
                        *Taxes and municipal fees included. Payment due upon arrival.
                    </div>
                </div>

                <!-- Reserve Button -->
                @if (Model.IsAvailableForSelectedDates)
                {
                    <a asp-controller="Bookings" asp-action="Create" 
                       asp-route-roomId="@Model.Room.RoomId"
                       asp-route-checkIn="@Model.CheckInDate.ToString("yyyy-MM-dd")"
                       asp-route-checkOut="@Model.CheckOutDate.ToString("yyyy-MM-dd")"
                       asp-route-guests="@Model.Guests"
                       class="btn btn-gold w-100 py-3 fs-6">
                        <i class="bi bi-calendar-check me-1"></i> Reserve Now &ndash; Pay at Hotel
                    </a>
                }
                else
                {
                    <button class="btn btn-secondary w-100 py-3 fs-6" disabled>
                        <i class="bi bi-calendar-x me-1"></i> Reserved for Selected Dates
                    </button>
                    <p class="text-danger small text-center mt-2 mb-0">
                        Please pick alternate dates using the date selector above.
                    </p>
                }

                <div class="text-center mt-3 text-muted small">
                    <i class="bi bi-shield-check text-success me-1"></i> Instant confirmation. No booking fees.
                </div>
            </div>
        </div>
    </div>

    <!-- Suggested Similar Rooms -->
    @if (Model.SimilarRooms.Any())
    {
        <div class="mt-5 pt-5 border-top">
            <h3 class="display-6 font-heading mb-4">You May Also Admire</h3>
            <div class="row g-4">
                @foreach (var sRoom in Model.SimilarRooms)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="room-card">
                            <div class="room-card-image-wrap">
                                <img src="@sRoom.ImageUrl" alt="@sRoom.RoomType" class="room-card-image" loading="lazy" />
                                <span class="room-badge-type">@sRoom.RoomType</span>
                                <div class="room-badge-price">
                                    $@sRoom.PricePerNight.ToString("N0") <span>/ night</span>
                                </div>
                            </div>
                            <div class="room-card-body">
                                <h4 class="room-card-title h5">@sRoom.RoomType</h4>
                                <div class="room-meta-tags mb-3">
                                    <span class="room-meta-tag"><i class="bi bi-people text-warning"></i> Up to @sRoom.Capacity guests</span>
                                </div>
                                <div class="room-card-actions">
                                    <a asp-action="Details" asp-route-id="@sRoom.RoomId" class="btn btn-outline-forest w-100">
                                        View Suite
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        const checkIn = document.getElementById('detailsCheckIn');
        const checkOut = document.getElementById('detailsCheckOut');

        checkIn.addEventListener('change', function () {
            if (checkIn.value) {
                const nextDay = new Date(checkIn.value);
                nextDay.setDate(nextDay.getDate() + 1);
                const nextDayStr = nextDay.toISOString().split('T')[0];
                checkOut.min = nextDayStr;
                if (checkOut.value <= checkIn.value) {
                    checkOut.value = nextDayStr;
                }
            }
        });
    </script>
}
