<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GrandVista Admin Portal</title>
    
    <!-- Google Fonts: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- GrandVista Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-light">

    <div class="admin-wrapper">
        <!-- Sidebar -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="admin-sidebar-header d-flex align-items-center justify-content-between">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="gv-brand text-decoration-none">
                    <i class="bi bi-gem gv-brand-icon"></i>
                    <span>GRANDVISTA</span>
                </a>
                <button class="btn btn-sm btn-link text-white d-lg-none" id="sidebarCloseBtn">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="px-3 pt-3">
                <div class="p-2 rounded bg-dark text-center border border-secondary border-opacity-25">
                    <small class="text-uppercase text-warning fw-bold letter-spacing-1">Portal Mode</small>
                    <div class="fw-semibold text-white small">Hotel Management System</div>
                </div>
            </div>

            <nav class="admin-sidebar-nav">
                <div class="text-uppercase text-white-50 px-3 py-2 small fw-bold" style="font-size: 0.72rem; letter-spacing: 0.1em;">
                    Management
                </div>

                <a class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                <a class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rooms" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Rooms" asp-action="Index">
                    <i class="bi bi-door-open-fill"></i>
                    <span>Manage Rooms</span>
                </a>

                <a class="admin-nav-item @(ViewContext.RouteData.Values["controller"]?.ToString() == "Bookings" ? "active" : "")" 
                   asp-area="Admin" asp-controller="Bookings" asp-action="Index">
                    <i class="bi bi-calendar2-check-fill"></i>
                    <span>Manage Bookings</span>
                </a>

                <div class="text-uppercase text-white-50 px-3 py-2 mt-3 small fw-bold" style="font-size: 0.72rem; letter-spacing: 0.1em;">
                    External Navigation
                </div>

                <a class="admin-nav-item" asp-area="" asp-controller="Home" asp-action="Index" target="_blank">
                    <i class="bi bi-box-arrow-up-right"></i>
                    <span>Live Guest Site</span>
                </a>

                <a class="admin-nav-item text-danger mt-4" asp-area="" asp-controller="Account" asp-action="Logout">
                    <i class="bi bi-box-arrow-left text-danger"></i>
                    <span>Logout</span>
                </a>
            </nav>

            <div class="p-3 border-top border-secondary border-opacity-25 text-white-50 small">
                <div>Logged in as:</div>
                <div class="text-white fw-semibold text-truncate">@User.Identity?.Name</div>
            </div>
        </aside>

        <!-- Main Content Area -->
        <div class="admin-content-area">
            <!-- Topbar -->
            <header class="admin-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary btn-sm d-lg-none" id="sidebarToggleBtn">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <h5 class="mb-0 font-heading text-dark">@ViewData["Title"]</h5>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                        <i class="bi bi-database-check me-1"></i> Database Live (SQL Server)
                    </span>

                    <div class="dropdown">
                        <button class="btn btn-outline-dark btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle fs-5 text-secondary"></i>
                            <span class="d-none d-md-inline fw-semibold">Administrator</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><h6 class="dropdown-header">@User.Identity?.Name</h6></li>
                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" asp-area="" asp-controller="Account" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i>Sign Out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <!-- Alerts -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="px-4 pt-3">
                    <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                        <div>@TempData["SuccessMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="px-4 pt-3">
                    <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                        <div>@TempData["ErrorMessage"]</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                </div>
            }

            <!-- Page Body -->
            <main class="admin-page-body">
                @RenderBody()
            </main>
        </div>
    </div>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById('sidebarToggleBtn')?.addEventListener('click', function() {
            document.getElementById('adminSidebar')?.classList.toggle('show');
        });
        document.getElementById('sidebarCloseBtn')?.addEventListener('click', function() {
            document.getElementById('adminSidebar')?.classList.remove('show');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
