<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GrandVista Hotel & Luxury Suites</title>
    <meta name="description" content="Experience comfort and discover luxury at GrandVista Hotel. Book boutique suites, oceanfront rooms, and presidential penthouses with seamless online reservations." />
    
    <!-- Google Fonts: Playfair Display & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- GrandVista Bespoke Luxury Design System -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

    <!-- Navigation Bar -->
    <header>
        <nav class="navbar navbar-expand-lg gv-navbar">
            <div class="container">
                <a class="navbar-brand gv-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-gem gv-brand-icon"></i>
                    <span>GRANDVISTA</span>
                </a>

                <button class="navbar-toggler text-white border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#gvNavbarContent" aria-controls="gvNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-2 text-white"></i>
                </button>

                <div class="collapse navbar-collapse" id="gvNavbarContent">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link gv-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gv-nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Rooms" ? "active" : "")" asp-controller="Rooms" asp-action="Index">Rooms & Suites</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gv-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "About" ? "active" : "")" asp-controller="Home" asp-action="About">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gv-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Contact" ? "active" : "")" asp-controller="Home" asp-action="Contact">Contact</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link gv-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyBooking" ? "active" : "")" asp-controller="Bookings" asp-action="MyBooking">
                                <i class="bi bi-journal-bookmark me-1 text-warning"></i> My Booking
                            </a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                        {
                            <a class="btn btn-outline-gold btn-sm" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                <i class="bi bi-shield-lock-fill"></i> Admin Portal
                            </a>
                            <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-outline-gold btn-sm" asp-controller="Account" asp-action="Login">
                                <i class="bi bi-lock-fill"></i> Admin Login
                            </a>
                        }
                        <a class="btn btn-gold btn-sm" asp-controller="Rooms" asp-action="Index">
                            <i class="bi bi-calendar-check"></i> Book Now
                        </a>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Toast / Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        </div>
    }

    <!-- Main Content Area -->
    <main role="main" class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="gv-footer mt-auto">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <div class="gv-brand mb-3">
                        <i class="bi bi-gem gv-brand-icon"></i>
                        <span>GRANDVISTA</span>
                    </div>
                    <p class="pe-lg-4">
                        A sanctuary of quiet elegance and luxury hospitality. Offering personalized guest service, world-class suites, and culinary excellence in the heart of the city.
                    </p>
                    <div class="d-flex gap-3 text-gold fs-5">
                        <a href="#" class="text-white opacity-75 hover-gold"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white opacity-75 hover-gold"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white opacity-75 hover-gold"><i class="bi bi-twitter-x"></i></a>
                        <a href="#" class="text-white opacity-75 hover-gold"><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="gv-footer-title">Quick Links</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a asp-controller="Rooms" asp-action="Index">Suites & Rooms</a></li>
                        <li class="mb-2"><a asp-controller="Bookings" asp-action="MyBooking">Retrieve Reservation</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="About">Our Story</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Contact">Concierge & Contact</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="gv-footer-title">Suites Collection</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a asp-controller="Rooms" asp-action="Index" asp-route-roomType="Presidential Penthouse">Presidential Penthouse</a></li>
                        <li class="mb-2"><a asp-controller="Rooms" asp-action="Index" asp-route-roomType="Signature Royal Villa">Signature Royal Villa</a></li>
                        <li class="mb-2"><a asp-controller="Rooms" asp-action="Index" asp-route-roomType="Deluxe Oceanfront Suite">Deluxe Oceanfront</a></li>
                        <li class="mb-2"><a asp-controller="Rooms" asp-action="Index" asp-route-roomType="Executive King Suite">Executive King Suite</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="gv-footer-title">Contact Concierge</h5>
                    <p class="mb-2"><i class="bi bi-geo-alt me-2 text-warning"></i> 742 Grand Vista Boulevard, Coastal Bay</p>
                    <p class="mb-2"><i class="bi bi-telephone me-2 text-warning"></i> +1 (800) 555-VISTA</p>
                    <p class="mb-2"><i class="bi bi-envelope me-2 text-warning"></i> concierge@grandvista.com</p>
                    <p class="mb-0"><i class="bi bi-clock me-2 text-warning"></i> Check-in: 3:00 PM | Check-out: 11:00 AM</p>
                </div>
            </div>

            <div class="footer-divider"></div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-secondary small">
                <div>
                    &copy; @DateTime.UtcNow.Year GrandVista Hotel. All rights reserved.
                </div>
                <div class="mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary me-3">Privacy Policy</a>
                    <a href="#" class="text-secondary me-3">Terms of Service</a>
                    <a asp-controller="Account" asp-action="Login" class="text-warning">Admin Access</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
